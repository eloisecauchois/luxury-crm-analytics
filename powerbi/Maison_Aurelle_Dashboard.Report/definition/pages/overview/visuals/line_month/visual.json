{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "line_month",
  "position": {
    "x": 20,
    "y": 195,
    "z": 8000,
    "width": 1240,
    "height": 230,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "transactions"
                    }
                  },
                  "Property": "month"
                }
              },
              "queryRef": "transactions.month",
              "nativeQueryRef": "month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "transactions"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "transactions.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly revenue has grown steadily since 2023, reaching ~€3M in autumn 2026'"
                }
              }
            }
          }
        }
      ]
    }
  }
}