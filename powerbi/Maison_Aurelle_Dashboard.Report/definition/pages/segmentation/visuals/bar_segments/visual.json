{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "bar_segments",
  "position": {
    "x": 20,
    "y": 195,
    "z": 17000,
    "width": 600,
    "height": 510,
    "tabOrder": 17000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "rfm"
                    }
                  },
                  "Property": "segment"
                }
              },
              "queryRef": "rfm.segment",
              "nativeQueryRef": "segment"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "rfm"
                    }
                  },
                  "Property": "% of Clients"
                }
              },
              "queryRef": "rfm.% of Clients",
              "nativeQueryRef": "% of Clients"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "rfm"
                    }
                  },
                  "Property": "% of Revenue"
                }
              },
              "queryRef": "rfm.% of Revenue",
              "nativeQueryRef": "% of Revenue"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "rfm"
                  }
                },
                "Property": "% of Revenue"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'10% of clients (VICs) bring 50% of revenue'"
                }
              }
            }
          }
        }
      ]
    }
  }
}