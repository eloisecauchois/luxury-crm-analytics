model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table transactions
ref table clients
ref table products
ref table boutiques
ref table sales_associates
ref table rfm
ref table call_list
ref table retention
ref table cross_sell
